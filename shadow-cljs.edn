;; shadow-cljs configuration
{:deps true
 :nrepl {:port 8001}
 :builds
 {:app {:target :browser
        :output-dir "public/resources/js"
        :modules {:app {:init-fn com.felipegsilva.core/main!}}
        :dev {:build-hooks [(teknql.tailwind/start-watch!)]}
        :release {:build-hooks [(teknql.tailwind/compile-release!)]}
        :devtools {:http-root "public/"
                   :http-port 3000}
        :tailwind/output "public/resources/css/bundle.css"
        :tailwind/files {:tailwind-css "public/resources/css/index.css"}}}}
